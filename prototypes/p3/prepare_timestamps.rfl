(set args (at (.sys.args) 'user))
(set src (at args 'src))
(set dest (at args 'dest))
(set t (.db.splayed.get src))
(set off 946684800000000000)
(set q (table [instrument_id ts_recv ts_event bid_px ask_px bid_sz ask_sz] (list (at t 'instrument_id) (as 'TIMESTAMP (- (at t 'ts_recv) off)) (as 'TIMESTAMP (- (at t 'ts_event) off)) (at t 'bid_px) (at t 'ask_px) (at t 'bid_sz) (at t 'ask_sz))))
(.db.splayed.set dest q {compress: false})
(println "ROWS" (count (.db.splayed.get dest)))
