(set root (at (at (.sys.args) 'user) 'root))
(set held (.db.splayed.get root))
(set c (fn [name] (take (at held name) 22000)))
(set tail (table [instrument_id ts_recv ts_event bid_px ask_px bid_sz ask_sz] (list (c 'instrument_id) (c 'ts_recv) (c 'ts_event) (c 'bid_px) (c 'ask_px) (c 'bid_sz) (c 'ask_sz))))
(println "BEFORE" (count held) (sum (at held 'instrument_id)) (sum (at held 'bid_sz)))
(set join (fn [name] (concat (at held name) (at tail name))))
(set rewrite (fn [] (.db.splayed.set root (table [instrument_id ts_recv ts_event bid_px ask_px bid_sz ask_sz] (list (.idx.drop (join 'instrument_id)) (.idx.drop (join 'ts_recv)) (.idx.drop (join 'ts_event)) (.idx.drop (join 'bid_px)) (.idx.drop (join 'ask_px)) (.idx.drop (join 'bid_sz)) (.idx.drop (join 'ask_sz)))) {compress: false index: false})))
(println "APPEND_TIME" (.mem.ts (count (rewrite))))
(println "HELD_AFTER" (count held) (sum (at held 'instrument_id)) (sum (at held 'bid_sz)))
(set after (.db.splayed.get root))
(println "FRESH" (count after) (sum (at after 'instrument_id)) (sum (at after 'bid_sz)))
(println "NOINDEX" (nil? (.idx.info (at after 'instrument_id))) (nil? (.idx.info (at after 'ts_recv))) (nil? (.idx.info (at after 'ts_event))) (nil? (.idx.info (at after 'bid_px))) (nil? (.idx.info (at after 'ask_px))) (nil? (.idx.info (at after 'bid_sz))) (nil? (.idx.info (at after 'ask_sz))))
(println "TAIL" (count tail) (sum (at tail 'instrument_id)) (sum (at tail 'bid_sz)))
