(set args (at (.sys.args) 'user))
(set a (.db.parted.get (at args 'baseline) 'quotes))
(set b (.db.parted.get (at args 'stream) 'quotes))
(println "ROWS" (count a) (count b))
(println "SCHEMA" (all (== (key a) (key b))))
(if (!= (count a) (count b)) (raise "row count mismatch"))
(if (not (all (== (key a) (key b)))) (raise "schema mismatch"))
(map (fn [c] (do
  (set x (at a c))
  (set y (at b c))
  (set nx (nil? x))
  (set ny (nil? y))
  (set masks_match (all (== nx ny)))
  (set values_match (all (or nx (== x y))))
  (println "COLUMN" c "null_masks_equal" masks_match "values_equal" values_match "nulls" (sum nx))
  (if (not (and masks_match values_match)) (raise (format "column % mismatch" c)))))
  [instrument_id ts_recv ts_event bid_px ask_px bid_sz ask_sz parent])
