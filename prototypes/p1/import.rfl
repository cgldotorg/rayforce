(set args (at (.sys.args) 'user))
(set csv (at args 'csv))
(set db (at args 'db))
(set mode (at args 'mode))
(set dest (format "%/2026.10.29/quotes" db))
(set sym (format "%/.sym" db))
(if (== mode "stream")
    (.csv.splayed (dict [sym_path durable] (list sym true)) [I64 I64 I64 I64 I64 I64 I64 SYMBOL] csv dest)
    (.db.splayed.set dest (.csv.read [I64 I64 I64 I64 I64 I64 I64 SYMBOL] csv) sym))
(set q (.db.parted.get db 'quotes))
(println "ROWS" (count q))
(println "INSTRUMENT_SUM" (sum (at q 'instrument_id)))
(println "PARENTS" (count (distinct (at q 'parent))))
